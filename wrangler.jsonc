{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "njmtech-security",
  "account_id": "c2db456075f9ab9579ff7bb76674a984",
  // Custom entry: re-exports the OpenNext fetch handler + our Workflow classes.
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    // Defense in depth vs SSRF: fetch() can never reach private/internal addresses.
    "global_fetch_strictly_public"
  ],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [{ "pattern": "security.njmtech.co.za", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 120000 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "njmtech-security",
      "database_id": "a66e1b21-0fad-4105-9ab6-c3474060de3d",
      "migrations_dir": "drizzle"
    }
  ],
  "workflows": [
    { "name": "njmtech-security-scan", "binding": "SCAN_WORKFLOW", "class_name": "ScanWorkflow" },
    { "name": "njmtech-security-load-shard", "binding": "LOAD_SHARD_WORKFLOW", "class_name": "LoadShardWorkflow" }
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "njmtech-security" }],
  "vars": {
    "APP_URL": "https://security.njmtech.co.za",
    "EMAIL_FROM": "NJM Tech Security <security@send.njmtech.co.za>",
    "EMAIL_REPLY_TO": "",
    "REPORT_PRICE_CENTS": "49900",
    "SANITY_PROJECT_ID": "w1uoie7f",
    "SANITY_DATASET": "production"
  }
  // Secrets (Infisical env-vault:/njmtech-security → wrangler secret bulk):
  //   SESSION_SECRET, RESEND_API_KEY, YOCO_SECRET_KEY, YOCO_WEBHOOK_SECRET, ADMIN_EMAILS (kept out of this public repo),
  //   SANITY_API_READ_TOKEN (admin draft previews). SANITY_API_WRITE_TOKEN stays in Infisical only (scripts).
}
