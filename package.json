{
  "name": "njmtech-stress-test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "weak-server": "node scripts/weak-test-server.mjs",
    "db:migrate:local": "wrangler d1 migrations apply njmtech-security --local",
    "db:migrate:remote": "wrangler d1 migrations apply njmtech-security --remote",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.generated.d.ts",
    "build:next": "next build",
    "sanity:seed": "node scripts/sanity-seed.mjs"
  },
  "dependencies": {
    "@portabletext/react": "4.0.3",
    "@sanity/client": "7.13.1",
    "@sanity/image-url": "1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.39.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@opennextjs/cloudflare": "^1.20.18",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0",
    "marked": "15.0.12"
  },
  "packageManager": "pnpm@10.6.5"
}
